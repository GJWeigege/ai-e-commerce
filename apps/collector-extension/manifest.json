{
  "manifest_version": 3,
  "name": "AIECOM Ozon Collector",
  "version": "1.0.0",
  "description": "复用 Chrome 登录态采集 Ozon 商品，支持单页手动与批量任务轮询",
  "permissions": ["storage", "activeTab", "scripting", "alarms", "tabs"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*/*",
    "https://www.ozon.ru/*",
    "https://ozon.ru/*"
  ],
  "action": {
    "default_title": "AIECOM 采集",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ozon.ru/*", "https://ozon.ru/*"],
      "js": ["content.js"]
    }
  ]
}
