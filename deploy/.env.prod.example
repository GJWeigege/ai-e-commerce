# 复制为仓库根目录 .env.prod 后使用：
#   cp deploy/.env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- 数据库（compose 内网，勿对公网暴露）---
POSTGRES_USER=aiecom
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=aiecom

# --- 对外访问 ---
# 浏览器打开的正式地址（含协议，无尾斜杠）。CORS 依赖此项。
WEB_ORIGIN=https://your.domain
# 宿主机映射 Web 容器端口（前面再挂 HTTPS 反代）
WEB_PUBLISH_PORT=8080

# --- 安全 ---
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=7d
# 店铺 Token 加密；生产必须单独配置，且不要与 JWT_SECRET 相同
CREDENTIAL_ENCRYPTION_KEY=change-me-shop-secret

# --- LLM（AI 选品）---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai-compatible

# --- Wildberries ---
WB_LOCALE=ru
WB_LISTING_CONCURRENCY=4
# WB_DEFAULT_SUBJECT_ID=
# WB_WAREHOUSE_ID=

# --- 首次部署可临时 true 写入种子账号，成功后改回 false 并重建/重启 ---
RUN_SEED=false
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=请改成强密码
# SEED_DEMO_PASSWORD=请改成强密码
