# PostgreSQL
DATABASE_URL=postgresql://aiecom:aiecom@localhost:5433/aiecom?schema=public

# Redis + BullMQ
REDIS_URL=redis://localhost:6380
# 上架全局并发（不同店铺可并行；同一店铺仍串行）。默认 4，最大 16
# WB_LISTING_CONCURRENCY=4

# LLM（AI 选品必须配置）
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai-compatible

# 店铺 Token 加密密钥（生产必须单独配置，禁止与 JWT_SECRET 相同）
CREDENTIAL_ENCRYPTION_KEY=change-me-shop-secret-please-rotate

# Wildberries Content / Prices / Marketplace API 地址（可选覆盖）
# WB_DEFAULT_SUBJECT_ID=
# WB_CONTENT_API_BASE=https://content-api.wildberries.ru
# WB_PRICES_API_BASE=https://discounts-prices-api.wildberries.ru
# WB_MARKETPLACE_API_BASE=https://marketplace-api.wildberries.ru
# WB_WAREHOUSE_ID=
WB_LOCALE=ru

# JWT（生产禁止使用示例值；采集插件会复用该 Token，默认 7 天）
JWT_SECRET=change-me-in-production-please-rotate
JWT_EXPIRES_IN=7d

# API
PORT=3000
# 本地开发用 http://localhost:8000；生产必须改成 https://你的域名（与浏览器 Origin 一致）
WEB_ORIGIN=http://localhost:8000
# 额外允许的浏览器 Origin，逗号分隔
# WEB_ORIGINS=
# 可选。填写后只放行这些 Chrome 插件 ID；不填则放行所有 chrome-extension://
# CHROME_EXTENSION_IDS=abcdefghijklmnopqrstuvwxyzabcdef

# 生产部署见 deploy/.env.prod.example 与 README「生产部署」小节

# 种子账号（仅本地开发）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456
SEED_DEMO_PASSWORD=Demo@123456
